---
interface Props { diagonal?: boolean; class?: string }
const { diagonal = false, class: className = '' } = Astro.props;
---
<svg class={className} width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {diagonal ? <path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /> : <path d="M4 12h16m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />}
</svg>
