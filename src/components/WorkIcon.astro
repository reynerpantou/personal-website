---
interface Props { kind: string }
const { kind } = Astro.props;
---
<svg viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
  {kind === 'search' && <><circle cx="13" cy="13" r="7"/><path d="m18 18 9 9M10 13h6M13 10v6"/></>}
  {kind === 'platform' && <><rect x="3" y="4" width="10" height="8" rx="2"/><rect x="19" y="20" width="10" height="8" rx="2"/><path d="M8 12v12h11M13 8h11v12"/></>}
  {kind === 'database' && <><ellipse cx="16" cy="7" rx="10" ry="4"/><path d="M6 7v18c0 5 20 5 20 0V7M6 16c0 5 20 5 20 0"/></>}
  {kind === 'ads' && <><path d="M5 13h7l13-7v20l-13-7H5ZM12 19l3 8H9l-3-8M25 13h4v6h-4"/></>}
  {kind === 'card' && <><rect x="4" y="5" width="24" height="22" rx="3"/><path d="M4 12h24M9 17h7M9 22h13M21 17h2"/></>}
  {kind === 'shield' && <><path d="m16 3 11 5v8c0 7-11 13-11 13S5 23 5 16V8ZM11 16l4 4 7-8"/></>}
</svg>
