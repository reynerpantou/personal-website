---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { profile } from '../data/site';
interface Props { title?: string; description?: string; home?: boolean; noindex?: boolean; canonicalPath?: string }
const { title, description = profile.description, home = false, noindex = false, canonicalPath } = Astro.props;
const pageTitle = title ? `${title} — ${profile.name}` : `${profile.name} — Backend Engineer`;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const links = [{ label: 'Work', id: 'work' }, { label: 'Experience', id: 'experience' }, { label: 'CV', id: 'resume' }, { label: 'About', id: 'about' }];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f6f2" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={new URL('/social-card.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Reyner Pantou — Making complex systems feel simple." />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Person', name: profile.name, url: Astro.site, jobTitle: profile.role, sameAs: [profile.linkedin] })} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="/" aria-label="Reyner Pantou, home">reyner<span class="brand-dot">.</span></a>
        <nav aria-label="Main navigation">
          {links.map(link => <a href={`${home ? '' : '/'}#${link.id}`}>{link.label}</a>)}
          <a class="nav-contact" href={`${home ? '' : '/'}#contact`}>Let’s talk <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="shell footer">
      <p>© {new Date().getFullYear()} Reyner Pantou</p>
      <p>Built with care. Kept simple.</p>
      <a href={`mailto:${profile.email}`}>Email <span aria-hidden="true">↗</span></a>
    </footer>
  </body>
</html>
