---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { profile, projects } from '../data/site';
const toolkit = ['Go', 'Elasticsearch', 'Redis', 'PostgreSQL', 'Kafka', 'gRPC'];
---
<Base home>
  <section class="hero" aria-labelledby="intro-title">
    <div class="hero-copy">
      <p class="eyebrow">Backend engineer · Jakarta, Indonesia</p>
      <h1 id="intro-title">Hi, I’m <span>Reyner.</span></h1>
      <p class="hero-subtitle">I build the systems behind<br class="desktop-break" /> <span>a good experience.</span></p>
      <p class="hero-description">Five years working on search and commerce at Tokopedia and ByteDance. I work with Go, distributed systems, and the details that keep software reliable.</p>
      <div class="hero-actions"><a class="button button-primary" href="#work">Explore my work <Arrow /></a><a class="button button-secondary" href="/cv/">View CV <Arrow diagonal /></a></div>
    </div>
    <aside class="profile-card" aria-label="Engineering focus">
      <div class="file-bar"><span class="file-icon" aria-hidden="true">{'{ }'}</span><span>profile.go</span><span class="file-language">Go</span></div>
      <pre aria-hidden="true"><code><span class="code-muted">// A little about me</span>
<span class="code-keyword">engineer</span> := <span class="code-type">Engineer</span>{'{'}
  Name:  <span class="code-string">"Reyner Pantou"</span>,
  Focus: []<span class="code-type">string</span>{'{'}
    <span class="code-string">"Search platforms"</span>,
    <span class="code-string">"Distributed systems"</span>,
    <span class="code-string">"Reliable services"</span>,
  {'}'},
{'}'}</code></pre>
      <p class="sr-only">My engineering focus is search platforms, distributed systems, and reliable services.</p>
      <div class="profile-note"><span aria-hidden="true">↳</span> Clear APIs. Predictable behavior.</div>
    </aside>
    <div class="hero-history"><span class="eyebrow">Previously at</span><span><span class="company-tokopedia">Tokopedia</span> <span class="separator" aria-hidden="true">/</span> <span class="company-bytedance">ByteDance</span></span><span class="history-detail">2021 — 2026</span></div>
  </section>

  <section id="work" class="section" aria-labelledby="work-title">
    <div class="section-heading"><div><p class="eyebrow">01 / Selected work</p><h2 id="work-title">What I’ve worked on.</h2></div><p>Professional work and an idea<br class="desktop-break" /> I’m building next.</p></div>
    <div class="project-grid">
      {projects.map((project, index) => <article class="project-card">
        <div class="project-top"><span class="project-icon" aria-hidden="true">{index === 0 ? <svg viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="13" cy="13" r="7"/><path d="m18 18 9 9M10 13h6M13 10v6"/></svg> : <svg viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="6" width="22" height="20" rx="3"/><path d="M5 12h22M10 17h4M10 21h9M21 18v4"/></svg>}</span><span class="status">{project.status}</span></div>
        <h3><a class="project-title" href={`/work/${project.slug}/`}>{project.title}<Arrow diagonal /></a></h3>
        <p>{project.summary}</p>
        <ul class="tags" aria-label="Project focus">{project.tags.map(tag => <li>{tag}</li>)}</ul>
        <a class="text-link project-link" href={`/work/${project.slug}/`}>Read {index === 0 ? 'the work overview' : 'the project notes'} <Arrow /><span class="sr-only">: {project.title}</span></a>
      </article>)}
    </div>
  </section>

  <section id="experience" class="section" aria-labelledby="experience-title">
    <div class="section-heading"><div><p class="eyebrow">02 / Experience</p><h2 id="experience-title">Built in production.</h2></div><p>Search infrastructure.<br class="desktop-break" /> Cross-platform integration.</p></div>
    <article class="experience-row"><div class="experience-meta"><span class="experience-date">2021 — 2026</span><span class="muted">5 years</span></div><div class="experience-body"><h3>Tokopedia <span class="muted" aria-hidden="true">→</span> ByteDance</h3><p class="role">Backend Engineering · Search</p><p>Worked on the search results platform, connecting search and ads with the commerce experience. Contributed to the Tokopedia × TikTok Shop integration and the migration of services to ByteCloud.</p><p>My work also included service design, performance troubleshooting, mentoring, and keeping production systems running.</p><a class="text-link" href="/work/commerce-search/">More about the work <Arrow /></a></div></article>
    <div class="toolkit"><p class="eyebrow">Tools I work with</p><ul aria-label="Engineering toolkit">{toolkit.map(tool => <li>{tool}</li>)}</ul></div>
  </section>

  <section id="about" class="section" aria-labelledby="about-title">
    <div class="section-heading"><div><p class="eyebrow">03 / About</p><h2 id="about-title">A little more about me.</h2></div></div>
    <div class="about-columns"><div class="about-copy"><p>I’m a backend engineer based in Jakarta, originally from Surabaya. I enjoy turning complicated problems into systems people can understand and depend on.</p><p>Search and distributed systems are where I’ve spent most of my time. I care about clear APIs, predictable behavior, and software that is easier to operate.</p><p>Outside work, I explore ideas by building small products and learning as I go.</p></div><aside class="education-card"><span class="eyebrow">Education</span><h3>Computer Science</h3><p>Petra Christian University</p><p class="muted">B.Sc. · 2017 — 2021</p></aside></div>
  </section>

  <section id="resume" class="resume-panel" aria-labelledby="resume-title"><div><p class="eyebrow">04 / Curriculum vitae</p><h2 id="resume-title">The full picture.</h2><p>My experience, skills, and education in one PDF.</p></div><div class="resume-actions"><a class="button button-primary" href="/cv/">View CV <Arrow /></a><a class="text-link" href={profile.cv} download="Reyner-Pantou-CV.pdf">Download PDF <Arrow diagonal /></a></div></section>

  <section id="contact" class="contact-section" aria-labelledby="contact-title"><div><p class="eyebrow">05 / Get in touch</p><h2 id="contact-title">Let’s talk.</h2><p>Have an engineering problem, a project,<br class="desktop-break" /> or an opportunity in mind? I’d like to hear about it.</p></div><div class="contact-actions"><a class="button button-primary" href={`mailto:${profile.email}`}>Send me an email <Arrow diagonal /></a><a class="text-link" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <Arrow diagonal /><span class="sr-only"> (opens in a new tab)</span></a><span class="contact-location">Based in Jakarta, Indonesia</span></div></section>
</Base>
